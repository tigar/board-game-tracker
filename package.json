{
	"name": "board-game-tracker",
	"version": "0.1.0",
	"description": "Offline-first PWA for tracking board game plays with cloud sync",
	"type": "module",
	"author": "Adam Tigar",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "vite dev",
		"lint": "biome check .",
		"lint-fix": "biome check --write .",
		"test": "jest",
		"test-watch": "jest --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/jest": "^29.5.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"ts-jest": "^29.2.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.3"
	},
	"dependencies": {
		"dexie": "^4.0.0"
	}
}
